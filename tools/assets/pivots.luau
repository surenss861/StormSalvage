-- @file Generates and checks the authored asset pivot table
-- @domain world
-- @status stable
-- @see [[AssetPivotFix.luau]]
-- Authored pivots for ServerStorage.Assets.
--
-- Why: Studio resets every Model pivot under ServerStorage.Assets to its bounding-box centre when
-- it opens the Rojo-built place file, although the file holds the authored pivots (WorldPivotData).
-- Placement code relies on those pivots (base centre, plus deliberate offsets such as the crane
-- and the shop counters), so the RC1-RC5 artifacts placed everything half underground. The dev
-- place never showed it, because its assets were imported in Studio.
--
-- This script reads the authored pivots from a Rojo build and writes src/server/AssetPivots.luau,
-- which the server applies to the asset templates before anything is placed.
--
--   lune run tools/assets/pivots generate <place.rbxl>   write src/server/AssetPivots.luau
--   lune run tools/assets/pivots check <place.rbxl>      fail if that file is out of date
local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")

local mode, placePath = process.args[1], process.args[2]
if (mode ~= "generate" and mode ~= "check") or not placePath then
	print("usage: lune run tools/assets/pivots generate|check <place.rbxl>")
	process.exit(2)
end

local OUT = "src/server/AssetPivots.luau"
local game = roblox.deserializePlace(fs.readFile(placePath))
local assets = game:GetService("ServerStorage"):FindFirstChild("Assets")
assert(assets, "no ServerStorage.Assets in " .. placePath)

local function fmt(n: number): string
	local s = string.format("%.4f", n):gsub("0+$", ""):gsub("%.$", "")
	return if s == "-0" then "0" else s
end

local rows = {}
local seen = {}
local duplicates = {}
for _, set in assets:GetChildren() do
	for _, model in set:GetChildren() do
		if model.ClassName == "Model" then
			local key = set.Name .. "/" .. model.Name
			if seen[key] then
				table.insert(duplicates, key)
			end
			seen[key] = true
			local cf = model.WorldPivotData
			assert(cf, "no authored pivot on " .. key)
			local c = { cf:GetComponents() }
			local parts = {}
			for _, v in c do
				table.insert(parts, fmt(v))
			end
			table.insert(rows, string.format('\t["%s"] = { %s },', key, table.concat(parts, ", ")))
		end
	end
end
if #duplicates > 0 then
	error("duplicate asset names (pivots would be ambiguous): " .. table.concat(duplicates, ", "))
end
table.sort(rows)

local text = table.concat({
	"-- @file Authored asset pivots (generated)",
	"-- @domain world",
	"-- @status stable",
	"-- @see [[AssetPivotFix.luau]]",
	"-- GENERATED by tools/assets/pivots.luau from the asset files. Do not edit by hand.",
	"-- Authored pivot (CFrame components) of each ServerStorage.Assets model, keyed \"set/name\".",
	"-- See AssetPivotFix.luau for why the server needs this.",
	"return {",
	table.concat(rows, "\n"),
	"}",
	"",
}, "\n")

if mode == "generate" then
	fs.writeFile(OUT, text)
	print(string.format("wrote %s (%d assets)", OUT, #rows))
else
	local current = if fs.isFile(OUT) then fs.readFile(OUT) else ""
	if current ~= text then
		print(OUT .. " is out of date with the asset files. Run: lune run tools/assets/pivots generate <build.rbxl>")
		process.exit(1)
	end
	print(string.format("%s matches the asset files (%d assets)", OUT, #rows))
end
